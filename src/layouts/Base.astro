---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/portfolio';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = Astro.site ? new URL('og.png', Astro.site).href : `${base}og.png`;

const nav = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#approaches', label: 'Approaches' },
  { href: '#projects', label: 'Projects' },
  { href: '#case-study', label: 'Case study' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Sora:wght@500;600;700&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="brand" href="#home">
          <Icon name="code" size={24} />
          <span>{profile.name}</span>
        </a>
        <nav aria-label="Sections">
          <button class="icon-btn menu-btn" aria-expanded="false" aria-controls="nav-list">
            <Icon name="menu" label="Open menu" />
          </button>
          <ul id="nav-list">
            {nav.map((n) => (
              <li><a href={n.href}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <button class="icon-btn theme-btn" type="button" aria-label="Switch colour theme">
          <span class="when-dark"><Icon name="sun" /></span>
          <span class="when-light"><Icon name="moon" /></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p><strong>{profile.name}</strong><span class="footer-role">{profile.roles[0]}</span></p>
        <p class="footer-note">© {new Date().getFullYear()} {profile.name}. Built with Astro, hosted on GitHub Pages.</p>
        <div class="footer-links">
          <a href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" label="LinkedIn" /></a>
          <a href={profile.github} target="_blank" rel="noopener"><Icon name="github" label="GitHub" /></a>
          <a href="#home" class="to-top"><Icon name="arrowUp" label="Back to top" size={18} /></a>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-btn')?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
      });

      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const list = document.getElementById('nav-list');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        list?.classList.toggle('open', !open);
      });
      list?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) {
          list.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
        }
      });

      // Highlight the nav link for the section in view.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('#nav-list a')];
      const sections = links
        .map((a) => document.querySelector(a.getAttribute('href')!))
        .filter(Boolean) as Element[];
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((a) =>
              a.toggleAttribute('aria-current', a.getAttribute('href') === `#${entry.target.id}`)
            );
          }
        },
        { rootMargin: '-45% 0px -50% 0px' }
      );
      sections.forEach((s) => io.observe(s));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    background: var(--accent);
    color: var(--on-accent);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    z-index: 100;
    text-decoration: none;
  }
  .skip:focus {
    top: 1rem;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 600 1.2rem var(--font-display);
    text-decoration: none;
    margin-right: auto;
  }
  .brand :global(svg) {
    color: var(--accent);
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.4rem 0.75rem;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .icon-btn:hover {
    border-color: var(--accent);
  }
  .menu-btn {
    display: none;
  }
  :global([data-theme='light']) .when-dark,
  :global([data-theme='dark']) .when-light {
    display: none;
  }

  @media (max-width: 900px) {
    .menu-btn {
      display: grid;
    }
    nav ul {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 0.75rem 1.25rem 1.25rem;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--line);
    }
    nav ul.open {
      display: flex;
    }
    nav a {
      padding: 0.7rem 0;
      font-size: 1rem;
    }
  }

  .footer {
    border-top: 1px solid var(--line);
    padding-block: 1.75rem;
    font-size: 0.88rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .footer-role {
    color: var(--muted);
    margin-left: 1rem;
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  .footer-note {
    color: var(--muted);
    margin-right: auto;
  }
  .footer-links {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .footer-links a {
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--accent);
  }
  .to-top {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
</style>
