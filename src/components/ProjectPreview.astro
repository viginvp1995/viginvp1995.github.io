---
// A small mock "app window" tinted with the project's accent. Replace it with
// a real screenshot by setting `image` on the project in portfolio.ts.
interface Props {
  accent: string;
  variant: number;
}
const { accent, variant } = Astro.props;
const v = variant % 3;
---
<svg viewBox="0 0 160 100" class="preview" aria-hidden="true">
  <rect width="160" height="100" rx="6" fill="var(--bg-raised)" />
  <rect width="160" height="12" rx="6" fill={accent} opacity="0.18" />
  <circle cx="8" cy="6" r="2" fill={accent} /><circle cx="15" cy="6" r="2" fill={accent} opacity=".6" /><circle cx="22" cy="6" r="2" fill={accent} opacity=".35" />
  {v === 0 && (
    <g>
      <rect x="8" y="20" width="34" height="72" rx="3" fill={accent} opacity="0.16" />
      <rect x="13" y="27" width="22" height="3" rx="1.5" fill={accent} opacity=".7" />
      <rect x="13" y="35" width="18" height="3" rx="1.5" fill="var(--muted)" opacity=".5" />
      <rect x="13" y="43" width="20" height="3" rx="1.5" fill="var(--muted)" opacity=".5" />
      <rect x="50" y="20" width="102" height="30" rx="3" fill={accent} opacity="0.12" />
      <rect x="56" y="27" width="50" height="4" rx="2" fill="var(--text)" opacity=".7" />
      <rect x="56" y="36" width="70" height="3" rx="1.5" fill="var(--muted)" opacity=".5" />
      <rect x="50" y="56" width="48" height="36" rx="3" fill={accent} opacity="0.22" />
      <rect x="104" y="56" width="48" height="36" rx="3" fill={accent} opacity="0.1" />
    </g>
  )}
  {v === 1 && (
    <g>
      <rect x="8" y="20" width="144" height="22" rx="3" fill={accent} opacity="0.14" />
      <rect x="14" y="27" width="60" height="4" rx="2" fill="var(--text)" opacity=".7" />
      <path d="M8 88 L30 72 L52 78 L74 58 L96 64 L118 50 L152 56" fill="none" stroke={accent} stroke-width="2" />
      <path d="M8 88 L30 72 L52 78 L74 58 L96 64 L118 50 L152 56 V92 H8Z" fill={accent} opacity="0.12" />
    </g>
  )}
  {v === 2 && (
    <g>
      <rect x="8" y="20" width="68" height="72" rx="3" fill={accent} opacity="0.18" />
      <circle cx="42" cy="50" r="14" fill={accent} opacity=".5" />
      <rect x="24" y="72" width="36" height="4" rx="2" fill="var(--text)" opacity=".6" />
      <rect x="84" y="20" width="68" height="20" rx="3" fill={accent} opacity="0.12" />
      <rect x="84" y="46" width="68" height="20" rx="3" fill={accent} opacity="0.12" />
      <rect x="84" y="72" width="68" height="20" rx="3" fill={accent} opacity="0.12" />
    </g>
  )}
</svg>

<style>
  .preview {
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
</style>
