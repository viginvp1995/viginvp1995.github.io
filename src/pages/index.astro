---
import * as si from 'simple-icons';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { profile, about, skills, approaches, projects, experience, caseStudy } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Very dark brand colours (Express, Jest's black, etc.) would vanish on the
// dark theme, so those fall back to the text colour.
function brandColour(hex: string) {
  const n = parseInt(hex, 16);
  const lum = 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
  return lum < 70 ? 'var(--text)' : `#${hex}`;
}
const icons = si as unknown as Record<string, { path: string; hex: string } | undefined>;
const skillList = skills.map((s) => {
  const icon = s.icon ? icons[s.icon] : undefined;
  return { ...s, path: icon?.path, colour: icon ? brandColour(icon.hex) : undefined };
});
---
<Base
  title={`${profile.name} | ${profile.roles[0]}`}
  description={`${profile.name}, ${profile.roles.slice(0, 3).join(', ')} based in ${profile.location}. ${profile.intro}`}
>
  <Hero />

  <section class="section" id="about">
    <div class="wrap about-grid">
      <div>
        {profile.avatar && (
          <img class="avatar" src={`${base}${profile.avatar}`} alt={`${profile.name} portrait`} width="120" height="120" loading="lazy" />
        )}
        <h2 class="section-title"><Icon name="user" />About me</h2>
        <div class="prose">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="highlights">
        {about.highlights.map((h) => (
          <li class="panel">
            <strong>{h.value}</strong>
            <span>{h.label}</span>
          </li>
        ))}
      </ul>

      <div id="skills">
        <h2 class="section-title"><Icon name="layers" />Tech skills</h2>
        <ul class="skills">
          {skillList.map((s) => (
            <li>
              {s.path && (
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" style={`color:${s.colour}`}>
                  <path d={s.path} fill="currentColor" />
                </svg>
              )}
              {s.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="approaches">
    <div class="wrap">
      <h2 class="section-title"><Icon name="bulb" />How I work</h2>
      <ul class="approaches">
        {approaches.map((a) => (
          <li class="panel">
            <span class="approach-icon"><Icon name={a.icon} size={24} /></span>
            <div>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <h2 class="section-title"><Icon name="folder" />Featured projects</h2>
      <ul class="projects">
        {projects.map((p, i) => (
          <li class="panel project">
            {p.image ? (
              <img src={`${base}${p.image}`} alt={`${p.name} screenshot`} loading="lazy" />
            ) : (
              <ProjectPreview accent={p.accent} variant={i} />
            )}
            <h3>{p.name}</h3>
            <ul class="stack" aria-label="Built with">
              {p.stack.map((t) => <li>{t}</li>)}
            </ul>
            <p>{p.body}</p>
            {p.url && (
              <a class="text-link" href={p.url} target="_blank" rel="noopener">
                Visit site <Icon name="external" size={14} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="case-study">
    <div class="wrap">
      <h2 class="section-title"><Icon name="doc" />Case study</h2>
      <div class="case panel">
        <div class="case-head">
          <div>
            <p class="case-tag">{caseStudy.tag}</p>
            <h3>{caseStudy.project}</h3>
            <p class="case-summary">{caseStudy.summary}</p>
          </div>
          <div class="case-stat">
            <strong>{caseStudy.outcome.stat}</strong>
            <span>{caseStudy.outcome.label}</span>
          </div>
        </div>
        <ol class="case-blocks">
          {caseStudy.blocks.map((b, i) => (
            <li>
              <span class="case-step">{String(i + 1).padStart(2, '0')}</span>
              <h4>{b.heading}</h4>
              <p>{b.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="wrap exp-grid">
      <div>
        <h2 class="section-title"><Icon name="briefcase" />Experience</h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <div class="panel job">
                <h3>{e.company}</h3>
                <p class="job-role">{e.role}</p>
                <p class="job-meta">{e.period}<span>{e.location}</span></p>
                <ul>
                  {e.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div id="contact">
        <h2 class="section-title"><Icon name="send" />Get in touch</h2>
        <p class="contact-lead">I'm open to new opportunities and interesting conversations. The quickest way to reach me is email or LinkedIn.</p>
        <ul class="contact-list">
          <li><Icon name="mail" /><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><Icon name="linkedin" /><a href={profile.linkedin} target="_blank" rel="noopener">{profile.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</a></li>
          <li><Icon name="github" /><a href={profile.github} target="_blank" rel="noopener">{profile.github.replace(/^https?:\/\//, '')}</a></li>
          <li><Icon name="pin" /><span>{profile.location}</span></li>
        </ul>
        <div class="panel connect">
          <Icon name="code" size={30} />
          <p>Let's build something great together.</p>
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>Send me an email <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* About + skills */
  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent);
    display: block;
    margin-bottom: 1.1rem;
    box-shadow: 0 10px 30px -12px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-areas:
      'about skills'
      'high skills';
    gap: 2rem 3.5rem;
  }
  .about-grid > div:first-child { grid-area: about; }
  .highlights { grid-area: high; }
  #skills { grid-area: skills; }

  .prose {
    display: grid;
    gap: 1rem;
    color: var(--muted);
    max-width: 38rem;
  }
  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .highlights li {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .highlights strong {
    font: 600 1.05rem/1.25 var(--font-display);
  }
  .highlights span {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .skills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .skills li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    font-size: 0.86rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  /* Approaches */
  .approaches {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .approaches li {
    padding: 1.4rem;
    display: flex;
    gap: 1rem;
  }
  .approach-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .approaches h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .approaches p {
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Projects */
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .project {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .project img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
  }
  .project h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 0.4rem;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .stack li {
    font-size: 0.74rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .project p {
    font-size: 0.86rem;
    color: var(--muted);
    flex: 1;
  }
  .project .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Case study */
  .case {
    padding: 2rem;
    display: grid;
    gap: 1.75rem;
  }
  .case-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: start;
  }
  .case-tag {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .case-head h3 {
    font: 600 1.4rem/1.3 var(--font-display);
  }
  .case-summary {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: 44rem;
  }
  .case-stat {
    display: grid;
    justify-items: end;
    text-align: right;
    padding: 0.9rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    min-width: 10rem;
  }
  .case-stat strong {
    font: 700 1.9rem/1 var(--font-display);
    color: var(--accent);
  }
  .case-stat span {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .case-blocks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .case-blocks li {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    display: grid;
    gap: 0.4rem;
  }
  .case-step {
    font: 500 0.75rem/1 var(--font-code);
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .case-blocks h4 {
    font: 600 1rem/1.3 var(--font-display);
  }
  .case-blocks p {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Experience + contact */
  .exp-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
  }
  .timeline {
    list-style: none;
    padding: 0 0 0 1.6rem;
    margin: 0;
    position: relative;
    display: grid;
    gap: 1rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--line-strong);
  }
  .timeline > li {
    position: relative;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.6rem + 0px);
    top: 1.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline > li:first-child::before {
    background: var(--accent);
  }
  .job {
    padding: 1.3rem 1.4rem;
  }
  .job h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .job-role {
    margin-top: 0.2rem;
    font-weight: 500;
  }
  .job-meta {
    font-size: 0.84rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .job-meta span::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.8em;
    background: var(--line-strong);
    margin-inline: 0.6rem;
  }
  .job ul {
    margin: 0.8rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.9rem;
    color: var(--muted);
    display: grid;
    gap: 0.3rem;
  }

  .contact-lead {
    color: var(--muted);
    max-width: 30rem;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 1.6rem;
    display: grid;
    gap: 0.8rem;
    font-size: 0.92rem;
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .contact-list :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .contact-list a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-list a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .connect {
    padding: 1.6rem;
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }
  .connect :global(svg:first-child) {
    color: var(--accent);
  }
  .connect p {
    font: 600 1.2rem/1.35 var(--font-display);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .about-grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'about' 'high' 'skills';
    }
    .approaches { grid-template-columns: repeat(2, 1fr); }
    .projects { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .case-head { grid-template-columns: 1fr; }
    .case-stat { justify-self: start; text-align: left; }
  }
  @media (max-width: 760px) {
    .section { padding-block: 3.25rem; }
    .highlights { grid-template-columns: repeat(2, 1fr); }
    .approaches { grid-template-columns: 1fr; }
    .projects { grid-template-columns: 1fr 1fr; }
    .exp-grid { grid-template-columns: 1fr; }
    .case-blocks { grid-template-columns: 1fr; }
    .case { padding: 1.4rem; }
  }
  @media (max-width: 480px) {
    .projects { grid-template-columns: 1fr; }
  }
</style>
